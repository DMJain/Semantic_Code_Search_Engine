# Copy to .env; the Makefile loads it automatically.

# Required. Matches docker-compose.yml.
DATABASE_URL=postgres://codesearch:codesearch@localhost:5432/codesearch?sslmode=disable

# Required by `make test`, which refuses to run when this is empty so the
# Postgres integration tests cannot silently skip. Tests never write to the
# database named here: each creates and drops its own codesearch_test_* database
# on this server (the role needs CREATEDB). `make test-db-clean` removes leftovers.
TEST_DATABASE_URL=postgres://codesearch:codesearch@localhost:5432/codesearch?sslmode=disable

# Query service listen address.
HTTP_ADDR=:8080

# Ollama runs natively on the host (not in Docker) to use the Metal GPU.
OLLAMA_URL=http://localhost:11434
OLLAMA_SUMMARY_MODEL=qwen2.5-coder:7b
# Must have prompt templates in internal/embed (qwen3-embedding:0.6b,
# nomic-embed-text).
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# Optional until the Q&A loop is implemented.
GROQ_API_KEY=
GROQ_MODEL=

# Required by fetch-repo: a stable Kubernetes release tag, e.g. v1.37.1.
KUBE_TAG=
KUBE_DIR=./data/kubernetes
